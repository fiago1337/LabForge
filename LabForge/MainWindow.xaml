<Window x:Class="LabForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabForge"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <StackPanel Margin="25">
            <TextBlock Text="LabForge"
               FontSize="30"
               FontWeight="Bold"
               Margin="0,0,0,10"/>

            <TextBlock Text="Создание отчётов по лабораторным работам"
               FontSize="16"
               TextWrapping="Wrap"/>

            <Button Content="Выбрать методичку"
                    Height="40"
                    Margin="0,25,0,0"
                    Click="SelectFileButton_Click"/>
            <Button Content="Очистить"
                    Height="35"
                    Margin="0,10,0,0"
                    Click="ClearButton_Click"/>
            <TextBlock x:Name="SelectedFileText"
                       Text="Методичка не выбрана"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText"
                       Text="Ожидание выбора методички"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Текст методички:"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,20,0,5"/>
            <ScrollViewer Height="180"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DocumentText"
                           Text="Здесь появится содержимое документа."
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>

    </Grid>
</Window>
